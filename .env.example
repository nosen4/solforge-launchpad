# ---------- Frontend (exposed to the browser, prefix VITE_) ----------
VITE_SITE_NAME=SolForge

# Strongly recommended: a dedicated RPC (Helius / QuickNode / Triton). Public RPC rate-limits.
VITE_RPC_MAINNET=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
VITE_RPC_DEVNET=https://api.devnet.solana.com

# Your wallet that receives platform fees. Leave blank = no platform fees.
VITE_FEE_WALLET=

# Platform fees in SOL
VITE_FEE_CREATE=0.1
VITE_FEE_REVOKE_MINT=0.05
VITE_FEE_REVOKE_FREEZE=0.05
VITE_FEE_REVOKE_UPDATE=0.05
VITE_FEE_POOL=0.1
VITE_FEE_REMOVE=0.1

# ---------- Server only (Vercel env vars, never VITE_) ----------
# Pinata JWT for IPFS uploads: https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
# Optional dedicated gateway, e.g. yourname.mypinata.cloud
PINATA_GATEWAY=
